# ---------------------------------------------------------------------------
# Susan Atelier -- website-nextjs environment variables
# Copy this file to `.env.local` and fill in real values for local dev.
# Never commit `.env.local` or any file containing real secrets.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time.
# All other vars are server-side only.
# ---------------------------------------------------------------------------

# --- Client-visible (bundled into JS) ----------------------------------------

# Canonical site origin (no trailing slash). Used by sitemap, robots, metadata,
# Open Graph images, and all JSON-LD absolute URLs.
NEXT_PUBLIC_SITE_URL=https://susanatelier.com

# WhatsApp number (with country code, no + or spaces). e.g. 91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=your_whatsapp_number_here

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# PostHog browser analytics. Get the public project token from PostHog project settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Server-side only (NEVER prefix with NEXT_PUBLIC) -------------------------

# Resend API key for transactional emails (acceptance, referral notifications).
RESEND_API_KEY=your_resend_api_key_here

# --- Build / CI --------------------------------------------------------------

# Disables Next.js build/runtime telemetry.
NEXT_TELEMETRY_DISABLED=1
