# ---------------------------------------------------------------------------
# Susan Atelier — environment variables
# Copy this file to `.env.local` and fill in real values for local dev / preview.
# All NEXT_PUBLIC_* vars are inlined into the client bundle at build time, so
# they must be set BEFORE `next build` / `next dev` runs.
# ---------------------------------------------------------------------------

# Canonical site origin (no trailing slash). Used by sitemap.ts, robots.ts,
# metadata, and all JSON-LD absolute URLs.
# Prelaunch placeholder is https://susanatelier.com — replace with the real
# domain (e.g. https://www.susanatelier.com) once DNS is pointed at Vercel.
NEXT_PUBLIC_SITE_URL=https://susanatelier.com

# WhatsApp number (with country code, no + or spaces) used by the waitlist and
# pre-order flows. e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Disables Next.js build/runtime telemetry (recommended on CI / Vercel).
NEXT_TELEMETRY_DISABLED=1
